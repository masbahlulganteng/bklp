function update_postage_details(elem){

   var frm = elem.form;
   var ship_to = $.trim(frm.postage_available_to.value);
   var zip_to = $.trim(frm.zip_to.value);
   var quantity = 1;

   if(! form_changed){
        var ship_to_selection = frm.postage_available_to;
        var ship_to_string = ship_to_selection.options[ship_to_selection.options.selectedIndex].text;
        var msg1 = "eBid Alert\n>> Shipping to";
        var msg2 = "is already selected and shown above."
        var msg = msg1 + " " + ship_to_string + " " + msg2;        
        alert(msg);
        return false;
   }  
   form_changed = false;



   if( frm.quantity ) 
   {
      quantity = frm.quantity.value;
   }

   var pattern = /^\d+$/;
   var max_quantity = typeof max_buynow_quantity != 'undefined' ? max_buynow_quantity : 1;

   if( '' != 'closed' &&  ! pattern.test( quantity ) )
   {
       alert( "eBid Alert\n>> Please enter whole numbers only. Maximum available is "+max_quantity);
       return false;
   }

   if( '' != 'closed' && quantity > max_quantity ) 
   {
           alert("Maximum available is "+max_quantity);
           return false;
   }


//   if( ! (ship_to == 'uk' && 0 || ship_to != 'uk' && 0) )
//   {
//      quantity = 1; 
//   }

   if( ! ship_to )    {
        ship_to = shipping_home_country;
   }

   var move_to_home_site = false;
   var link_to_move ;

   if( is_zip_need_for_country( ship_to ) && ! valid_zip( ship_to, zip_to ))   {
      form_changed = true;
      return false;
   }

   if( ship_to != current_site )    {
      for( var i = 0; i < shipping_available.length; i++)      {
         if( shipping_available[i] == ship_to && current_site != shipping_continent[i] ) 
         {
             move_to_home_site = confirm( "eBid Alert\n>> To show shipping prices in the local currency you can be transferred to eBid "+unescape(shipping_name[i])+" by clicking OK. Click CANCEL to go back.");
             link_to_move = shipping_link[i]+'&quantity='+quantity+'#ship';
             break;
         }
      }
   }



/*
   if( is_zip_need_for_country( ship_to )  || quantity > 1 )    {
      //if( ship_to !=  shipping_home_country || zip_to != shipping_home_zip || quantity > 1)       {
        SetCookie( 'zip_to' , zip_to , 0, 'ebid.net');
        if( ! move_to_home_site )        {
          if( ship_to ==  shipping_home_country )           {
             return send_postage_ajax_request(elem);
          }          else          {
             return send_postage_ajax_international_request(elem);
          }
        }
      //}
      //else      {
      //  SetCookie( 'zip_to' , '' , 0, 'ebid.net');
      //}
   }
*/

   SetCookie( 'ship_to' , ship_to , 0, 'ebid.net' );
   if( is_zip_need_for_country( ship_to ) )
   {
        SetCookie( 'zip_to' , zip_to , 0, 'ebid.net');
   }
   else
   {
       SetCookie( 'zip_to' , '' , 0, 'ebid.net');
   }

   if( ship_to == shipping_home_country )
   {
       if( 0 || quantity > 1 || typeof variation_buynow_price != 'undefined' )
       {
             return send_postage_ajax_request(elem);
       }
   }
   else
   {
      if( 0 || quantity > 1 || typeof variation_buynow_price != 'undefined' )
      {
          return send_postage_ajax_international_request(elem);
      }
   }


   if( move_to_home_site ) { window.location = link_to_move; return false;}

   for( var i=0; i < shipping_available.length; i++)
   {
      if( shipping_available[i] == ship_to && shipping_code[i])
      {
         $("#shipping_info").html(shipping_code[i]);
         $("#shipping_country").html(shipping_name_html[i]);
         $("#shipping_lowest_postage").html(shipping_lowest_postage[i]);
         $("#shipping_lowest_bid").html(shipping_lowest_bid[i]);

         $("#bid_quantity").val(quantity);
         $("#buynow_quantity").val(quantity);

         $("#shipping_country2").html(shipping_name_html[i]);
         $("#shipping_lowest_postage2").html(shipping_lowest_postage[i]);

/*
         if( typeof variation_buynow_price != 'undefined' )
         {
               $("#shipping_lowest_buynow").html(variation_buynow_print_price);
         }
         else
         {
*/
            $("#shipping_lowest_buynow").html(shipping_lowest_buynow[i]);
//         }
         $('#change_shipping_edit').collapse();

          return false;
      }
   }

   if( 0 && ship_to != shipping_home_country ) //intenational to ajax
   {
       return send_postage_ajax_international_request(elem);
   }
   return false;
}

